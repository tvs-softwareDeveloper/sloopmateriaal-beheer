DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=develop_materials_app
PORT=3000
# old: PUBLIC_HOST=http://localhost:3000
# leave empty: photo urls then use the address the app was opened on, so they work on the laptop and on a phone
PUBLIC_HOST=

# OpenAI: leave the key empty and the app works without ai.
# get a key at platform.openai.com, see sloop-vault/03 - OpenAI-account en API-sleutel.md
# never commit the real key and never put it in the frontend
OPENAI_API_KEY=
# photos: terra (better at counting a stack), search: luna (cheapest)
AI_MODEL_PHOTO=gpt-6.1-terra
AI_MODEL_SEARCH=gpt-6-luna
